generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  analyses     PlantAnalysis[]
  plantProfiles PlantProfile[]

  @@index([createdAt])
}

model PlantAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  plantName          String?
  plantCategory      String?
  symptomDescription String?
  imageKey           String   @unique
  originalFileName   String
  imageMimeType      String
  imageSize          Int
  status             String   @default("uploaded")
  result             Json?
  plantProfileId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantProfile       PlantProfile? @relation(fields: [plantProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([plantProfileId, createdAt(sort: Desc)])
}

model PlantProfile {
  id          String          @id @default(cuid())
  userId      String
  name        String
  species     String?
  category    String?
  location    String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    PlantAnalysis[]

  @@index([userId, name])
}

model ApiRateLimitWindow {
  key       String
  bucket    Int
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([key, bucket])
  @@index([updatedAt])
}
