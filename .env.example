# Copy this file to .env so Next.js and the Prisma CLI can load the same local settings.
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Private S3-compatible object storage (required in production; development uses .data/uploads if S3_BUCKET is blank)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers such as MinIO or R2
S3_ENDPOINT=
# Optional private local development storage location
LOCAL_STORAGE_DIR=.data/uploads
